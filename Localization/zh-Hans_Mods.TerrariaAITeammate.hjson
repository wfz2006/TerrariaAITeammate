Configs: {
	AIConfig: {
		DisplayName: 小星设置

		Headers: {
			ModelConnection: 模型连接
			Interaction: 聊天与战斗
			ModelParameters: 模型参数
			AssistanceAndDebug: 辅助与调试
		}

		ChatMode: {
			Label: 聊天接收方式
			Tooltip: "选择游戏聊天中的哪些消息会发给小星。"
		}

		UseLlm: {
			Label: 启用模型
			Tooltip: "让小星通过模型理解自然语言、回答问题和规划任务。"
		}

		ApiKey: {
			Label: API 密钥
			Tooltip: "填入模型服务的 API 密钥。已通过环境变量或本地密钥文件配置时可留空。"
		}

		BaseUrl: {
			Label: API 地址
			Tooltip: "填入服务商的 API 根地址。默认使用 DeepSeek 的 https://api.deepseek.com。"
		}

		Model: {
			Label: 模型名称
			Tooltip: "填写服务商提供的模型 ID，默认 deepseek-flash。"
		}

		UseCombatLlm: {
			Label: 战斗时请求模型
			Tooltip: "在战斗中允许小星额外请求模型判断局势。这些请求计入 API 用量。"
		}

		ThinkingMode: {
			Label: 思考模式
			Tooltip: "选择模型的思考模式。「服务商默认」由模型服务决定。"
		}

		ReasoningEffort: {
			Label: 推理强度
			Tooltip: "设置模型的推理强度。关闭思考时跳过此设置。"
		}

		UsePhysicsStructureView: {
			Label: 发送建筑详图
			Tooltip: "在规划请求中加入更细的建筑结构数据，会增加输入 Token。"
		}

		UseStructureOverview: {
			Label: 发送建筑概览
			Tooltip: "在规划请求中加入附近建筑的结构概览。"
		}

		AllowTeleportRecovery: {
			Label: 受阻时传送脱困
			Tooltip: "允许小星在通行受阻时传送脱困。默认关闭。"
		}

		AllowBlueprintWorldEditing: {
			Label: 蓝图直接编辑世界
			Tooltip: "允许按已保存的蓝图清理区域并恢复瓦片。材料来自小星的背包。"
		}

		MaxResponseTokens: {
			Label: 单次输出上限
			Tooltip: "每次模型回复的 Token 上限，默认 8192。加减按钮每次调整 256，也可以直接输入数值。"
		}

		DebugLog: {
			Label: 详细调试日志
			Tooltip: "记录更多模型回包和规划过程，便于排查问题。"
		}
	}

	CompanionChatMode: {
		Tooltip: ""
		Addressed: {
			Label: 称呼和快捷指令
			Tooltip: "接收 @小星 或以「小星，」开头的消息、独立快捷指令和暂停任务的继续指令。"
		}
		CommandsOnly: {
			Label: 仅 /ai 指令
			Tooltip: "在游戏聊天框输入 /ai 后接指令或消息。"
		}
		All: {
			Label: 全部聊天
			Tooltip: "普通聊天也会交给小星，可能增加模型请求。"
		}
	}

	LlmThinkingMode: {
		Tooltip: ""
		ProviderDefault.Label: 服务商默认
		Enabled.Label: 开启
		Disabled.Label: 关闭
	}

	LlmReasoningEffort: {
		Tooltip: ""
		ProviderDefault.Label: 服务商默认
		Low.Label: 低
		High.Label: 高
	}
}

Items.BlueprintWand.DisplayName: 蓝图法杖
