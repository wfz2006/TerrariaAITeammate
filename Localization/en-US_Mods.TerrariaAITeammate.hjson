Configs: {
	AIConfig: {
		DisplayName: Xiaoxing Settings

		Headers: {
			ModelConnection: Model connection
			Interaction: Chat and combat
			ModelParameters: Model parameters
			AssistanceAndDebug: Assistance and debugging
		}

		ChatMode: {
			Label: Chat routing
			Tooltip: "Choose which game chat messages go to Xiaoxing."
		}

		ApiKey: {
			Label: API key
			Tooltip: "Enter your provider's API key. Leave this blank if you've set a key through an environment variable or the local key file."
		}

		BaseUrl: {
			Label: API base URL
			Tooltip: "Enter your provider's API base URL. The default is https://api.deepseek.com."
		}

		Model: {
			Label: Model ID
			Tooltip: "Enter the model ID listed by your provider. The default is deepseek-flash."
		}

		UseLlm: {
			Label: Enable model
			Tooltip: "Use the model for natural-language instructions, questions, and task planning."
		}

		UseCombatLlm: {
			Label: Model calls during combat
			Tooltip: "Allow additional model requests during combat. These requests count toward API usage."
		}

		DebugLog: {
			Label: Detailed debug log
			Tooltip: "Log additional model responses and planning details for troubleshooting."
		}

		MaxResponseTokens: {
			Label: Output token limit
			Tooltip: "Maximum output tokens per model response. The default is 8192. The buttons adjust by 256, and you can enter a value directly."
		}

		ThinkingMode: {
			Label: Thinking mode
			Tooltip: "Choose the thinking mode. Provider default lets the model provider decide."
		}

		ReasoningEffort: {
			Label: Reasoning effort
			Tooltip: "Set the model's reasoning effort. This setting is skipped when thinking is off."
		}

		UsePhysicsStructureView: {
			Label: Send structure details
			Tooltip: "Include finer building data in planning requests. This increases input token usage."
		}

		UseStructureOverview: {
			Label: Send structure overview
			Tooltip: "Include an overview of nearby buildings in planning requests."
		}

		AllowTeleportRecovery: {
			Label: Teleport when stuck
			Tooltip: "Allow Xiaoxing to teleport when stuck. Off by default."
		}

		AllowBlueprintWorldEditing: {
			Label: Allow direct blueprint edits
			Tooltip: "Allow saved blueprints to clear regions and restore tiles with materials from Xiaoxing's inventory."
		}
	}

	CompanionChatMode: {
		Tooltip: ""

		Addressed: {
			Label: Addressed messages
			Tooltip: "@Xiaoxing messages, exact local shortcuts and a pending goal's resume shortcut."
		}

		CommandsOnly: {
			Label: /ai commands only
			Tooltip: "Type /ai followed by a command or message in game chat."
		}

		All: {
			Label: All chat
			Tooltip: "Forwards ordinary game chat too. This can cause additional model requests."
		}
	}

	LlmThinkingMode: {
		Tooltip: ""

		ProviderDefault: {
			Label: Provider Default
			Tooltip: ""
		}

		Enabled: {
			Label: Enabled
			Tooltip: ""
		}

		Disabled: {
			Label: Disabled
			Tooltip: ""
		}
	}

	LlmReasoningEffort: {
		Tooltip: ""

		ProviderDefault: {
			Label: Provider Default
			Tooltip: ""
		}

		Low: {
			Label: Low
			Tooltip: ""
		}

		High: {
			Label: High
			Tooltip: ""
		}
	}
}

Items: {
	BlueprintWand: {
		DisplayName: Blueprint Wand
		Tooltip: ""
	}
}
